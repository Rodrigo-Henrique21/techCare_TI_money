model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_prices","fact_indicators","dim_symbols","dim_indicators"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_prices
ref table fact_indicators
ref table dim_symbols
ref table dim_indicators

ref cultureInfo pt-BR

